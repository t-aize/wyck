# Optional values for the cTrader examples (examples/ctrader_*.rs).
# Copy to .env and fill in the values before running, for example:
# cargo run --example ctrader_accounts
# .env is ignored by Git. Never commit tokens or client secrets.
# Obtain an application and OAuth tokens through the cTrader Open API portal.

WYCK_OPENAPI_CLIENT_ID=
WYCK_OPENAPI_CLIENT_SECRET=
WYCK_OPENAPI_ACCESS_TOKEN=
WYCK_OPENAPI_REFRESH_TOKEN=
WYCK_OPENAPI_ACCOUNT_ID=
WYCK_OPENAPI_SYMBOL=EURUSD

# The trading tests require a demo account, a token with trading scope and this opt-in.
WYCK_OPENAPI_ALLOW_LIVE_TRADING=
