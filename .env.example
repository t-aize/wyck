# wyck :: cTrader Open API test/development environment
#
# Copy this file to `.env` in the repository root and fill it in:
#
#   cp .env.example .env
#
# `.env` is already covered by .gitignore's `.env*` pattern (with this file excluded from it by
# name), so it will not be committed by accident -- but double check `git status` before pushing
# anything regardless, especially after copying secrets around by hand.
#
# Nothing in this repository reads `.env` on its own: `scripts/*.rs` and `tests/live.rs` load it
# explicitly, through the `dotenvy` crate, at the very start of `main`/each test. Every other test
# (`cargo test` without `-- --ignored`) never touches the network and does not need any of this.
#
# Suggested order:
#
#   1. Fill in section 1 by hand (register an application first, see below).
#   2. cargo run --bin sign-in -- --write-env
#      This signs you in through the browser and writes section 2 for you.
#   3. cargo run --bin check-connection
#      A few seconds; confirms the values above actually work before running the slower suite.
#   4. cargo test --test live -- --ignored --nocapture
#      The full live test suite (read only unless you also opt into WYCK_OPENAPI_ALLOW_LIVE_TRADING).

# =================================================================================================
# 1. The registered application
# =================================================================================================
#
# Register one at https://openapi.ctrader.com/ ("Register an application"). Approval is by
# Spotware and can take a while. Register `http://localhost:8765` as a redirect URI (or whatever
# port you pass sign-in's --callback-port with).

# The client id the portal gave the application.
WYCK_OPENAPI_CLIENT_ID=

# The client secret that came with it. This is a password: never commit it, never log it, never
# paste it anywhere but here (sign-in and refresh-tokens strip it from every error message that
# could otherwise repeat it).
WYCK_OPENAPI_CLIENT_SECRET=

# =================================================================================================
# 2. Filled in by `cargo run --bin sign-in -- --write-env` -- leave blank until you have run it
# =================================================================================================

# The access token sign-in obtained. Lives about 30 days; used by every script and live test.
WYCK_OPENAPI_ACCESS_TOKEN=

# The refresh token sign-in obtained alongside it. Trading it in (refresh-tokens, or the Session
# type's own auto-refresh) invalidates the old one, so treat this value as disposable: whatever
# last wrote it here is the only copy that still works.
WYCK_OPENAPI_REFRESH_TOKEN=

# The demo trading account sign-in picked (or that you picked, if the token covers more than
# one). Every live test and script authorizes exactly this account before doing anything else.
WYCK_OPENAPI_ACCOUNT_ID=

# =================================================================================================
# 3. Optional -- sane defaults, override only if you need to
# =================================================================================================

# demo or live. Everything here defaults to, and is meant for, demo: check-connection and the
# scripts accept `live` (useful to confirm production credentials work), but the trading live
# test only ever runs against whatever account WYCK_OPENAPI_ACCOUNT_ID names, and refuses a live
# one outright regardless of this setting. There is no good reason to change this for testing.
WYCK_OPENAPI_ENVIRONMENT=demo

# The port sign-in's local redirect listener binds while it waits for the browser. Must match a
# redirect URI registered for the application exactly, port included. Change it if something
# else on your machine already holds 8765, or if you registered a different one.
WYCK_OPENAPI_CALLBACK_PORT=8765

# The symbol the live tests and check-connection exercise: subscriptions, history, margin, and
# (only if section 4 below is set) the trading test's order. Any symbol your demo account offers.
WYCK_OPENAPI_SYMBOL=EURUSD

# =================================================================================================
# 4. Trading opt-in -- leave this blank unless you mean it
# =================================================================================================
#
# Must be exactly `1` (not "true", not "yes") for
# `place_and_close_a_minimal_market_order_on_a_demo_account` in tests/live.rs to place and
# immediately close one minimal market order on the demo account above. Checked before that test
# does anything else, including connecting. Every other test and script never trades, no matter
# what this is set to. See "Trading safety" in the module docs of `wyck::openapi` for why this
# still matters on a demo account. WYCK_OPENAPI_ACCESS_TOKEN must also be a token signed in with
# the `trading` scope (`cargo run --bin sign-in -- --scope trading --write-env`); a read-only
# `accounts`-scope token is refused by the server for this test, opt-in or not.
WYCK_OPENAPI_ALLOW_LIVE_TRADING=
