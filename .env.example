# Config MCP cTrader — récupérée depuis cTrader Web → Settings → Remote MCP
# (démo pour commencer). Voir README.md → Configuration.
CTRADER_MCP_URL=https://mcp.ctrader.com/trading/mcp
CTRADER_MCP_TOKEN=

# Paramètres de trading
SYMBOL=XAUUSD
ATR_PERIOD=14
# M_1 | M_5 | M_15 | M_30 | H_1 | H_4 | D_1 | W_1 | MN_1
ATR_TIMEFRAME=H_1
ATR_MULTIPLIER=1.5
DEFAULT_RR=1.2
