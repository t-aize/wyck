# Auto detect text files and normalize line endings to LF on checkin.
* text=auto eol=lf

# Source
*.rs text eol=lf
Cargo.toml text eol=lf

# Docs / config
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.env.example text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Lockfile: don't let Git generate diffs, and mark it as generated for GitHub
Cargo.lock -diff linguist-generated=true

# Binaries: never touch, never diff as text
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Exclude non-essential files from repository archives (git archive / GitHub release tarballs)
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
