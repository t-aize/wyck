# Normalize line endings: LF in the repository and in working copies.
* text=auto eol=lf

# Windows scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.avif binary
*.eot binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.otf binary
*.png binary
*.ttf binary
*.webp binary
*.woff binary
*.woff2 binary

# Lockfiles are generated: collapse them in diffs and exclude them from language stats.
bun.lock linguist-generated=true -diff
bun.lockb binary linguist-generated=true
package-lock.json linguist-generated=true -diff
pnpm-lock.yaml linguist-generated=true -diff
yarn.lock linguist-generated=true -diff

# Exclude generated and vendored files from language stats.
next-env.d.ts linguist-generated=true
*.tsbuildinfo linguist-generated=true

# Keep repository archives (git archive) free of dev-only files.
.editorconfig export-ignore
.gitattributes export-ignore
.github export-ignore
.vscode export-ignore
.zed export-ignore
