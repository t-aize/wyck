{
  "version": "0.2.0",
  "configurations": [
    {
      // Windows: the Microsoft debugger reads the PDB files that Rust produces; CodeLLDB does not.
      "name": "Debug wyck (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/wyck.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo build wyck",
      "console": "internalConsole"
    },
    {
      // macOS and Linux.
      "name": "Debug wyck (LLDB)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/debug/wyck",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "cargo build wyck"
    }
  ]
}
