{
  // Biome is the only linter and formatter (`bun run check`).
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "tab_size": 2,
  "hard_tabs": false,
  "preferred_line_length": 100,
  "wrap_guides": [100],
  "file_scan_exclusions": ["**/.next", "**/out", "**/coverage", "..."],

  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    // Class helpers match `tailwind.mergeFunctions` in biome.json.
    "tailwindcss-language-server": {
      "settings": {
        "classFunctions": ["clsx", "cn", "cva", "twMerge", "twJoin"]
      }
    }
  },

  "languages": {
    "JavaScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "language_servers": ["typescript-ls", "vtsls", "!typescript-language-server", "..."]
    },
    "JSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TypeScript": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "language_servers": ["typescript-ls", "vtsls", "!typescript-language-server", "..."]
    },
    "TSX": {
      "formatter": { "language_server": { "name": "biome" } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "language_servers": ["typescript-ls", "vtsls", "!typescript-language-server", "..."]
    },
    "JSON": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "JSONC": {
      "formatter": { "language_server": { "name": "biome" } }
    },
    "CSS": {
      "formatter": { "language_server": { "name": "biome" } },
      "language_servers": ["tailwindcss-intellisense-css", "!vscode-css-language-server", "..."]
    },
    // Zed runs Prettier on these by default, which disagrees with Biome's formatting.
    "Markdown": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["biome", "format", "--stdin-file-path", "{buffer_path}"]
        }
      },
      "remove_trailing_whitespace_on_save": false,
      "soft_wrap": "editor_width"
    },
    "YAML": {
      "prettier": { "allowed": false },
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["biome", "format", "--stdin-file-path", "{buffer_path}"]
        }
      }
    }
  }
}
