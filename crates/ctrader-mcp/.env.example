# cTrader MCP demo environment
#
# Copy this file to crates/ctrader-mcp/.env and replace only the values needed
# for your test. The .env file is ignored by Git. Never commit a token.
#
# Use a DEMO account only. The current examples read process environment
# variables. Loading this file with dotenvy is part of the live-test bootstrap
# described in AUDIT.md and must happen explicitly outside the SDK library.

# Select the server used by the raw_call example.
# Allowed values: remote, local
# The default used by raw_call when this variable is absent is remote.
CTRADER_SERVICE=remote

# Official cTrader Remote MCP trading endpoint.
# Change this only when testing a controlled self-hosted proxy.
CTRADER_REMOTE_URL=https://mcp.ctrader.com/trading/mcp

# Bearer token for a cTrader DEMO account.
#
# Leave this empty in the committed example. Treat the real value like a
# password. Do not print it, add it to logs, paste it into bug reports, or use
# it in snapshots. Revoke and replace it if it is exposed.
CTRADER_REMOTE_TOKEN=

# Local MCP endpoint exposed by cTrader Desktop.
#
# Start cTrader Desktop, select a DEMO account, then enable the MCP server from
# Advanced -> MCP Server. Keep the trailing slash. Change the port here if the
# Desktop configuration uses a different one.
CTRADER_LOCAL_URL=http://127.0.0.1:9876/mcp/

# Mutating examples are disabled unless this exact value is 1.
#
# Keep 0 for read-only discovery and schema checks. Set 1 only after checking
# that the Remote token and the active Local account both belong to DEMO
# accounts. A mutation test can create, amend, cancel, or close trading state.
CTRADER_CONFIRM_DEMO=0

# Instrument used by the Remote mutation probe.
#
# BTCUSD is the current example default because it may be available outside
# normal forex market hours. Availability, symbol name, minimum volume, price
# precision, and trading schedule remain broker-specific and must be read from
# the live server before a mutation.
CTRADER_PROBE_SYMBOL=BTCUSD

# Remote wire volume in cents used by the mutation probe.
#
# This is not a lot count and must not be copied between instruments. Keep the
# smallest server-accepted demo volume. Confirm the live symbol metadata before
# enabling mutations.
CTRADER_PROBE_VOLUME_CENTS=1

# Stop distance used by the Remote probe, expressed in server points.
#
# This is not a display price and not a pip count. The correct value depends on
# the symbol precision returned by the live server. The example default matches
# the probe code but must be validated for the selected symbol.
CTRADER_PROBE_STOP_POINTS=50000000
