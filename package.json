{
  "name": "wyck",
  "version": "0.1.0",
  "description": "Website for Wyck, a terminal trading panel for cTrader: download the app and connect to it.",
  "keywords": [
    "ctrader",
    "trading",
    "website",
    "nextjs",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/t-aize/wyck#readme",
  "bugs": {
    "url": "https://github.com/t-aize/wyck/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t-aize/wyck.git"
  },
  "license": "Apache-2.0",
  "author": "t-aize",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.10.0",
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "verify": "bun run check && bun run typecheck && bun run build",
    "clean": "rimraf .next out coverage tsconfig.tsbuildinfo",
    "deps:outdated": "bun outdated",
    "deps:update": "bun update --latest",
    "info": "next info"
  },
  "dependencies": {
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
