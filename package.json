{
  "name": "aurum",
  "version": "0.1.8",
  "private": true,
  "license": "UNLICENSED",
  "author": "t-aize",
  "description": "Panel de trading terminal (TUI) pour XAUUSD, connecté au MCP cTrader.",
  "type": "module",
  "module": "src/index.tsx",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "start": "bun run src/index.tsx",
    "build": "bun build ./src/index.tsx --compile --minify --sourcemap --outfile ./dist/aurum",
    "build:check": "bun build ./src/index.tsx --compile --outfile ./dist/.build-check",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "clean": "rimraf dist",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "^0.5.3",
    "@opentui/react": "^0.5.3",
    "effect": "^3.22.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@happy-dom/global-registrator": "^20.11.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  }
}
